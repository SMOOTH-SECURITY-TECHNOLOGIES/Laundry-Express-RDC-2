# Copy to `.env.staging.local` or export these vars in your shell before remote staging runs.
# Do not commit the filled file.

# Remote staging target
STAGING_API_BASE_URL=https://staging-api.example.com/api/v1
STAGING_FRONTEND_URL=https://staging.example.com

# WebSocket logistique live (optionnel — dérivé de STAGING_API_BASE_URL)
STAGING_LOGISTICS_WS_URL=

# Remote staging database
STAGING_DATABASE_URL=postgresql+asyncpg://user:password@staging-db.example.com:5432/laundry_express
STAGING_DATABASE_URL_SYNC=postgresql://user:password@staging-db.example.com:5432/laundry_express

# Existing remote smoke-test user (optional)
STAGING_SMOKE_TEST_USER_EMAIL=
STAGING_SMOKE_TEST_USER_PASSWORD=

# Existing remote seeded roles used by the flow harness (optional but required for full 5/5 if the target needs them)
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_PARTNER_OWNER_EMAIL=
STAGING_PARTNER_OWNER_PASSWORD=
STAGING_DRIVER_EMAIL=
STAGING_DRIVER_PASSWORD=
STAGING_LOGISTICS_EMAIL=
STAGING_LOGISTICS_PASSWORD=

# Provider declaration for reporting only
STAGING_PAYMENT_PROVIDER_MODE=cash_only
