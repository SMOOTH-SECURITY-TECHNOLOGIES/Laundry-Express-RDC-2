# Application
APP_ENV=development
APP_NAME=Laundry Express RDC
APP_VERSION=1.0.0
API_PORT=8000
FRONTEND_PORT=3003

# Database
POSTGRES_DB=laundry_express
POSTGRES_USER=laundry_user
POSTGRES_PASSWORD=laundry_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL=postgresql+psycopg://laundry_user:laundry_pass@db:5432/laundry_express
DATABASE_URL_SYNC=postgresql://laundry_user:laundry_pass@db:5432/laundry_express

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Frontend (Vite) — required for controlled pilot
# En dev local, /api/v1 passe par le proxy Vite (voir vite.config.ts)
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:18000
VITE_USE_MOCK_API=false
VITE_APP_ENV=pilot
VITE_PILOT_MODE=true
VITE_PAYMENT_MODE=sandbox

# WebSocket logistique (optionnel — auto-dérivé de VITE_API_BASE_URL en dev/staging)
# Dev direct API : ws://localhost:18000/api/v1/logistics/live
# Staging HTTPS : wss://staging-api.example.com/api/v1/logistics/live
# VITE_LOGISTICS_WS_URL=wss://staging-api.example.com/api/v1/logistics/live
# VITE_API_URL=http://localhost:18000/api/v1

# Security — REQUIRED in production (never commit real values)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# URLs
FRONTEND_URL=http://localhost:3003
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1

# Email (Mailpit local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@laundryexpress.cd
SMTP_FROM_NAME=Laundry Express RDC
EMAIL_BACKEND=smtp

# AI Integration
GEMINI_API_KEY=your-gemini-api-key-here

# Payment Providers
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=

# File Storage
STORAGE_TYPE=local  # local, s3, cloudflare_r2
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# Features Flags
FEATURE_AI_SCANNING=true
FEATURE_REAL_TIME_TRACKING=true
FEATURE_MOBILE_PAYMENTS=true
FEATURE_WHATSAPP_NOTIFICATIONS=false

# Admin
ADMIN_EMAIL=admin@laundryexpress.cd
ADMIN_PASSWORD=
SUPER_ADMIN_EMAILS=admin@laundryexpress.cd

# Seed credentials (local dev — seed_default_credentials.py + verify scripts)
SEED_DEFAULT_PASSWORD=
SEED_SUPER_ADMIN_PASSWORD=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_INACTIVE_CUSTOMER_PASSWORD=password
SEED_NEW_CUSTOMER_PASSWORD=
SEED_PARTNER_OWNER_PASSWORD=
SEED_PARTNER_STAFF_PASSWORD=
SEED_LOGISTICS_PASSWORD=
SEED_LOGISTICS_2_PASSWORD=

# Worker
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000
WORKER_BROKER_URL=redis://redis:6379/0
WORKER_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Cache
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=laundry_

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_ENABLED=false
