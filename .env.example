# Application
APP_ENV=development
APP_NAME=Laundry Express RDC
APP_VERSION=1.0.0
API_PORT=8000
FRONTEND_PORT=5173

# Database
POSTGRES_DB=laundry_express
POSTGRES_USER=laundry_user
POSTGRES_PASSWORD=laundry_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URLs
DATABASE_URL=postgresql+psycopg://laundry_user:laundry_pass@db:5432/laundry_express
DATABASE_URL_SYNC=postgresql://laundry_user:laundry_pass@db:5432/laundry_express

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000/api/v1

# Email (Mailpit local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@laundryexpress.cd
SMTP_FROM_NAME=Laundry Express RDC
EMAIL_BACKEND=smtp

# AI Integration
GEMINI_API_KEY=your-gemini-api-key-here

# Payment Providers
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=

# File Storage
STORAGE_TYPE=local  # local, s3, cloudflare_r2
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# Features Flags
FEATURE_AI_SCANNING=true
FEATURE_REAL_TIME_TRACKING=true
FEATURE_MOBILE_PAYMENTS=true
FEATURE_WHATSAPP_NOTIFICATIONS=false

# Admin
ADMIN_EMAIL=admin@laundryexpress.cd
ADMIN_PASSWORD=
SUPER_ADMIN_EMAILS=admin@laundryexpress.cd

# Worker
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000
WORKER_BROKER_URL=redis://redis:6379/0
WORKER_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Cache
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=laundry_

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_ENABLED=false
