{
  "name": "laundry-express-rdc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:repo-safety": "node scripts/check_repo_safety.mjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:seeded-credentials": "python scripts/verify_seeded_credentials.py",
    "test:role-access": "python scripts/verify_role_access_matrix.py",
    "test:role-drift": "python scripts/detect_legacy_role_drift.py",
    "test:commissions-flow": "python scripts/verify_commissions_flow.py",
    "test:disputes-flow": "python scripts/verify_disputes_flow.py",
    "test:refunds-flow": "python scripts/verify_refunds_flow.py",
    "test:promotions-flow": "python scripts/verify_promotions_flow.py",
    "test:promo-pricing-flow": "python scripts/verify_promo_pricing_consumption.py",
    "test:content-flow": "python scripts/verify_content_flow.py",
    "test:subscriptions-flow": "python scripts/verify_subscriptions_flow.py",
    "test:tracking-flow": "python scripts/verify_tracking_flow.py",
    "test:advertisements-flow": "python scripts/verify_advertisements_flow.py",
    "test:loyalty-flow": "python scripts/verify_loyalty_flow.py",
    "test:loyalty-engine-flow": "python scripts/verify_loyalty_engine_flow.py",
    "test:loyalty-adjustment-flow": "python scripts/verify_loyalty_adjustment_flow.py",
    "test:loyalty-expiry-flow": "python scripts/verify_loyalty_expiry_flow.py",
    "test:referral-flow": "python scripts/verify_referral_flow.py",
    "test:referral-engine-flow": "python scripts/verify_referral_engine_flow.py",
    "test:referral-review-flow": "python scripts/verify_referral_review_flow.py",
    "test:referral-antifraud-flow": "python scripts/verify_referral_antifraud_flow.py",
    "test:loyalty-referral-reporting-flow": "python scripts/verify_loyalty_referral_reporting_flow.py",
    "test:admin-config-gate": "python scripts/run_admin_config_proof_gate.py",
    "test:logistics-flow": "python scripts/verify_logistics_flow.py",
    "test:marketplace-flow": "python scripts/verify_marketplace_flow.py",
    "test:browser-ui-flow": "node scripts/browser_ui_flow_check.mjs",
