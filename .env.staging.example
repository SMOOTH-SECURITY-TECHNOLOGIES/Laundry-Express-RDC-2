# Remote staging target
STAGING_API_BASE_URL=https://staging-api.example.com/api/v1
STAGING_FRONTEND_URL=https://staging.example.com

# WebSocket logistique live (dérivé automatiquement si absent)
# https://staging-api.../api/v1 -> wss://staging-api.../api/v1/logistics/live
STAGING_LOGISTICS_WS_URL=wss://staging-api.example.com/api/v1/logistics/live

# Remote staging database
STAGING_DATABASE_URL=postgresql+asyncpg://user:password@staging-db.example.com:5432/laundry_express
STAGING_DATABASE_URL_SYNC=postgresql://user:password@staging-db.example.com:5432/laundry_express

# Optional smoke credentials
STAGING_SMOKE_TEST_USER_EMAIL=staging-smoke@example.com
STAGING_SMOKE_TEST_USER_PASSWORD=

# Optional seeded role credentials used by staging flow verification
STAGING_ADMIN_EMAIL=admin@laundryexpress.cd
STAGING_ADMIN_PASSWORD=
STAGING_PARTNER_OWNER_EMAIL=owner@partner.com
STAGING_PARTNER_OWNER_PASSWORD=
STAGING_DRIVER_EMAIL=driver1@kinexpress.cd
STAGING_DRIVER_PASSWORD=
STAGING_LOGISTICS_EMAIL=logistics@laundryexpress.cd
STAGING_LOGISTICS_PASSWORD=

# Optional provider declaration
STAGING_PAYMENT_PROVIDER_MODE=cash_only
