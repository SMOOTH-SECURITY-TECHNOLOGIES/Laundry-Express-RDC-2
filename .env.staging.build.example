# Frontend build variables for remote staging (npm run build)
# Copy to `.env.staging.build` or pass via CI secrets before building the static bundle.
# Do not commit filled credentials.

# API HTTPS — le client dérive wss://.../logistics/live si VITE_LOGISTICS_WS_URL est absent
VITE_API_BASE_URL=https://staging-api.example.com/api/v1
VITE_LOGISTICS_WS_URL=wss://staging-api.example.com/api/v1/logistics/live

VITE_APP_ENV=staging
VITE_APP_NAME=Laundry Express RDC
VITE_PILOT_MODE=true
VITE_USE_MOCK_API=false
VITE_USE_REAL_API=true
VITE_PAYMENT_MODE=sandbox
VITE_FEATURE_REAL_TIME_TRACKING=true

# Optionnel : base API sans suffixe /api/v1 (fallback secondaire pour le WS)
# VITE_API_URL=https://staging-api.example.com/api/v1
